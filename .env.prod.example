# Used with: docker compose -f docker-compose.prod.yml up -d

SERVER_PORT=8082

POSTGRES_USER=files
POSTGRES_PASSWORD=<strong-password>
POSTGRES_DB=files

JWT_SECRET=<must match the prod JWT_SECRET used by auth and courses>
# Comma-separated. Add multiple origins if needed: https://app.example.com,https://staging.example.com
CORS_ORIGINS=https://your-frontend-domain.com

# Self-hosted MinIO (see docker-compose.prod.yml). S3_ENDPOINT is fixed to the internal
# "minio" hostname there — nothing to set here for it.
S3_REGION=us-east-1
S3_BUCKET=learnquest-files
S3_ACCESS_KEY=<generate a strong access key, not "minioadmin">
S3_SECRET_KEY=<generate a strong secret key, not "minioadmin">

# REQUIRED: the address the client's browser will actually use for presigned PUT/GET — must
# be reachable from the internet. Leaving this unset falls back to the internal "minio"
# hostname, which browsers cannot resolve, breaking every upload/download.
# No TLS yet (see TODO(no-tls) in docker-compose.prod.yml) — plain http://<server-ip>:9000
# for now; switch to an https domain once a TLS reverse proxy is in front of MinIO.
S3_PUBLIC_ENDPOINT=http://<server-ip>:9000

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

PRESIGNED_URL_TTL=1h
PENDING_FILE_TTL=24h

# To migrate off self-hosted MinIO to AWS S3 / Cloudflare R2 later:
# 1. Remove the minio/minio-init services from docker-compose.prod.yml
# 2. Replace S3_ENDPOINT: http://minio:9000 there with ${S3_ENDPOINT} pointing at S3/R2
# 3. Set S3_USE_PATH_STYLE=false and S3_PUBLIC_ENDPOINT= (blank — same address as S3_ENDPOINT)
# No Go code changes required either way.
